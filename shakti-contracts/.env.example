# SHAKTI-CHAIN Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# WALLET CONFIGURATION (REQUIRED)
# =============================================================================
# Private key for deployment wallet (without 0x prefix or with 0x prefix)
# WARNING: Never commit your actual private key to version control!
PRIVATE_KEY=your_private_key_here

# =============================================================================
# RPC PROVIDERS (OPTIONAL - defaults provided)
# =============================================================================
# Alchemy API Key (recommended for reliability)
ALCHEMY_API_KEY=your_alchemy_api_key

# Infura API Key (alternative provider)
INFURA_API_KEY=your_infura_api_key

# Custom RPC URLs (override defaults)
POLYGON_MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your_key
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key
POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key

# =============================================================================
# CONTRACT VERIFICATION (Etherscan V2 API)
# =============================================================================
# Etherscan API Key for contract verification (works for ALL networks including Polygon)
# PolygonScan has migrated to Etherscan V2 API
# Get your API key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# Legacy Polygonscan API Key (deprecated, use ETHERSCAN_API_KEY instead)
# POLYGONSCAN_API_KEY=your_polygonscan_api_key

# =============================================================================
# GAS REPORTING (OPTIONAL)
# =============================================================================
# Enable gas reporting in tests
REPORT_GAS=false

# CoinMarketCap API Key for USD gas estimates
# Get one at: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# =============================================================================
# DEPLOYMENT CONFIGURATION (OPTIONAL)
# =============================================================================
# Initial token supply (in ether units, default: 100000000 = 100M)
INITIAL_TOKEN_SUPPLY=100000000

# Staking reward rate in basis points (800 = 8% APY)
STAKING_REWARD_RATE=800

# Platform fee in basis points (200 = 2%)
PLATFORM_FEE=200

# Fee burn rate in basis points (3000 = 30% of fee burned)
FEE_BURN_RATE=3000

# =============================================================================
# TESTNET FAUCETS
# =============================================================================
# Mumbai Faucet: https://faucet.polygon.technology/
# Amoy Faucet: https://www.alchemy.com/faucets/polygon-amoy
