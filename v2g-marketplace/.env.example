# ShaktiChain V2G Marketplace - Environment Configuration

# === Backend Configuration ===

# Database
DATABASE_URL=sqlite:///data/v2g.db

# JWT Authentication
JWT_SECRET=v2g-marketplace-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=0

# Python
PYTHONUNBUFFERED=1

# === Frontend Configuration ===

# API URL (backend endpoint)
VITE_API_URL=http://localhost:8000

# Node Environment
NODE_ENV=development

# === Simulation Configuration ===

# Default simulation parameters
DEFAULT_NUM_AGENTS=100
DEFAULT_DURATION_DAYS=1
DEFAULT_REGION=delhi

# Token model parameters
ENABLE_TOKEN=true
INITIAL_STAKING_RATE=0.20
TARGET_STAKING_RATE=0.40

# === Security ===

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Production Settings ===

# Set to 1 for production
PRODUCTION=0

# Logging
LOG_LEVEL=info
