FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_WALLET_CONNECT_PROJECT_ID=
ARG VITE_POLYGON_RPC_URL=https://polygon-rpc.com
ARG VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ARG VITE_USE_TESTNET=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WALLET_CONNECT_PROJECT_ID=$VITE_WALLET_CONNECT_PROJECT_ID
ENV VITE_POLYGON_RPC_URL=$VITE_POLYGON_RPC_URL
ENV VITE_POLYGON_AMOY_RPC_URL=$VITE_POLYGON_AMOY_RPC_URL
ENV VITE_USE_TESTNET=$VITE_USE_TESTNET

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
