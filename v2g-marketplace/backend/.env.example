# V2G Marketplace Backend Environment Variables

# ======================
# Database Configuration
# ======================
DATABASE_URL=sqlite:///./v2g_marketplace.db

# ======================
# JWT Authentication
# ======================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# Blockchain Configuration
# ======================

# Network selection: polygon, polygon_amoy, or hardhat
BLOCKCHAIN_NETWORK=hardhat

# RPC URLs (optional - defaults will be used if not set)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Private key for backend wallet (for automated transactions)
# IMPORTANT: Never commit real private keys to version control
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract addresses (JSON format)
# Leave empty to use default addresses for the selected network
CONTRACT_ADDRESSES=

# Example for custom addresses:
# CONTRACT_ADDRESSES={"shakti_token":"0x...","energy_auction":"0x...","staking_pool":"0x...","reputation_system":"0x..."}

# ======================
# Event Sync Configuration
# ======================
SYNC_POLL_INTERVAL=12
SYNC_BATCH_SIZE=1000

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ======================
# Server Configuration
# ======================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ======================
# Demo Login Configuration
# ======================
# Demo login is enabled by default for ENVIRONMENT in {development, dev, test}
# Set ENABLE_DEMO_LOGIN=true to force-enable in any environment.
ENABLE_DEMO_LOGIN=false
DEMO_USER_EMAIL=demo@v2g.local
DEMO_USER_PASSWORD=demo-mode-not-for-production
DEMO_USER_ROLE=user
