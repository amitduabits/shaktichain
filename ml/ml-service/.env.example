# SHAKTI-CHAIN ML Service Environment Variables

# Server Configuration
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
ML_SERVICE_WORKERS=4
ML_SERVICE_DEBUG=false

# CORS (comma-separated origins)
ML_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# MLflow Configuration
ML_SERVICE_MLFLOW_TRACKING_URI=http://localhost:5000
ML_SERVICE_MLFLOW_REGISTRY_URI=http://localhost:5000

# Redis Configuration
ML_SERVICE_REDIS_URL=redis://localhost:6379/0

# Model Configuration
ML_SERVICE_MAX_MEMORY_MODELS=10
ML_SERVICE_WARMUP_ON_STARTUP=true
ML_SERVICE_MODEL_CACHE_TTL=3600

# A/B Testing
ML_SERVICE_AB_TEST_ENABLED=true
ML_SERVICE_CHALLENGER_TRAFFIC_PCT=0.1

# Latency Targets (milliseconds)
ML_SERVICE_FORECAST_LATENCY_TARGET_MS=200
ML_SERVICE_TRADING_LATENCY_TARGET_MS=50
ML_SERVICE_ANOMALY_LATENCY_TARGET_MS=100

# Feature Flags
ML_SERVICE_ENABLE_DRIFT_DETECTION=true
ML_SERVICE_ENABLE_EXPLANATION=true
