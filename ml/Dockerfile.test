FROM python:3.11-slim

WORKDIR /workspace

COPY ml/requirements.test.txt /tmp/ml-requirements-test.txt

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1+cpu && \
    pip install --no-cache-dir \
      -r /tmp/ml-requirements-test.txt

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace/ml:/workspace/ml/src
