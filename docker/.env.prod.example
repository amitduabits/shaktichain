# Production defaults
BACKEND_PORT=8000
GATEWAY_HTTP_PORT=80
ML_SERVICE_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

JWT_SECRET=replace-in-production
BACKEND_WORKERS=4
ML_SERVICE_WORKERS=4

# Graph production provider (set a real RPC URL)
GRAPH_ETHEREUM=amoy:${AMOY_RPC_URL}
AMOY_RPC_URL=

# Frontend build/runtime
VITE_API_URL=/api
VITE_WALLET_CONNECT_PROJECT_ID=
VITE_POLYGON_RPC_URL=https://polygon-rpc.com
VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
VITE_USE_TESTNET=false
